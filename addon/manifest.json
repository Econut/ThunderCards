{
  "manifest_version": 2,
  "name": "ThunderCards",
  "version": "1.7.7",
  "description": "Customizes Thunderbird Cards View with dark cards and separate sender name and address lines.",
  "browser_specific_settings": {
    "gecko": {
      "id": "unified-inbox-sender-lines@local.invalid",
      "strict_min_version": "160.0",
      "strict_max_version": "160.*"
    }
  },
  "permissions": ["storage", "theme"],
  "background": { "scripts": ["ember-theme.js"] },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "experiment_apis": {
    "senderLines": {
      "schema": "schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "events": ["startup"],
        "paths": [["senderLines"]],
        "script": "experiment.js"
      }
    }
  }
}















